# MaxIM Configuration & API Keys
# Copy this file to .env and populate your active keys

# Active Gateway Provider: 'local', 'openai', 'gemini', 'deepseek', 'openrouter', 'groq', 'anthropic'
ACTIVE_PROVIDER=local

# Local Model Settings (llama-server or Ollama)
UNSLOTH_BASE_URL=http://127.0.0.1:8080/v1
UNSLOTH_API_KEY=
LOCAL_MODEL_URL=http://localhost:11434/v1

# Cloud Model Keys (Optional for hybrid fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Telegram Uplink (Optional remote mobile chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Bindings
HOST=127.0.0.1
PORT=8000
